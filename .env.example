# ============================================================================
# Exemplo de Configurações de Ambiente (SEM SEGREDOS REAIS)
# Copie para .env apenas em ambiente local (o arquivo .env está no .gitignore)
# ============================================================================

# 1. Variáveis automáticas na Supabase Edge Function
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=SUA_SUPABASE_ANON_KEY_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=SUA_SUPABASE_SERVICE_ROLE_KEY_SECRETA

# 2. Endpoint da API REST consumido pelo ESP32 (Wokwi) e pelo Painel (Cloudflare Pages)
VITE_IOT_API_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/telemetry
